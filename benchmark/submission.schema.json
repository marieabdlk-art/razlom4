{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "razlom4-benchmark-submission/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark_id", "arm", "results"],
  "properties": {
    "schema": {"const": "razlom4-benchmark-submission/1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "arm": {
      "enum": ["single_agent", "best_of_4", "ordinary_debate", "razlom4_no_roles", "razlom4_full"]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id", "status", "selected_operator_ids",
          "rejected_assumption_ids", "probe_predictions",
          "detected_failure_ids", "mechanism", "usage"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["SOLUTION", "NO_VALID_SOLUTION", "ERROR"]},
          "selected_operator_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "rejected_assumption_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "probe_predictions": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "detected_failure_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "mechanism": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "trigger", "transformation", "state_changed", "output", "observable_prediction", "falsifier"],
            "properties": {
              "input": {"type": "string", "minLength": 1},
              "trigger": {"type": "string", "minLength": 1},
              "transformation": {"type": "string", "minLength": 1},
              "state_changed": {"type": "string", "minLength": 1},
              "output": {"type": "string", "minLength": 1},
              "observable_prediction": {"type": "string", "minLength": 1},
              "falsifier": {"type": "string", "minLength": 1}
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["calls", "input_tokens", "output_tokens"],
            "properties": {
              "calls": {"type": "integer", "minimum": 0},
              "input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
